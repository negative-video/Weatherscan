# Weatherscan configuration
# Copy to .env and edit. Every value below has a working default except
# MAPBOX_API_KEY, which is the only thing you must supply to get a full screen.

# ---------------------------------------------------------------------------
# Map tiles (REQUIRED for the radar, satellite and mini-map surfaces)
# ---------------------------------------------------------------------------
# Free tier: 50,000 map loads/month. Copy the "Default public token".
# https://account.mapbox.com/
MAPBOX_API_KEY=

# ---------------------------------------------------------------------------
# Weather source
# ---------------------------------------------------------------------------
# open-meteo      no key, no signup, no card, no per-day quota   (default)
# openweathermap  needs OPENWEATHER_API_KEY below
# home-assistant  reads a weather entity from your HA instance
WEATHER_PROVIDER=open-meteo

# --- OpenWeatherMap ---------------------------------------------------------
# Only used when WEATHER_PROVIDER=openweathermap.
#
# Note One Call 3.0 is a separate subscription that requires a credit card on
# file even for its free 1,000 calls/day. If your key is a plain free-tier key,
# leave OPENWEATHER_MODE=auto and the server drops to the 2.5 endpoints, which
# work without a card (3-hourly resolution, no UV).
#   auto     try One Call 3.0, fall back to 2.5   (default)
#   onecall  require One Call 3.0
#   free     only use the 2.5 endpoints
OPENWEATHER_API_KEY=
OPENWEATHER_MODE=auto

# --- Home Assistant ---------------------------------------------------------
# Only used when WEATHER_PROVIDER=home-assistant.
#
# If you already pipe OpenWeatherMap, AccuWeather, Met.no, a Tempest or an
# Ecowitt station into Home Assistant, point this at it and the display uses
# your own observations — no second API key, no duplicate rate limit.
#
# HA_TOKEN: Home Assistant → your profile → Security → Long-lived access tokens.
HA_URL=
HA_TOKEN=

# Leave blank to auto-detect (prefers weather.forecast_home).
# GET /api/status lists every weather.* entity your instance exposes.
HA_WEATHER_ENTITY=

# HA only knows one location. Anything further than this from your HA home
# (nearby cities, travel, international slides) comes from FALLBACK_PROVIDER.
HA_MATCH_RADIUS_KM=40
FALLBACK_PROVIDER=open-meteo

# Optional: override the coordinates HA reports for itself.
HA_LATITUDE=
HA_LONGITUDE=

# Optional: nominate your own sensors instead of the derived values.
HA_AQI_ENTITY=
HA_UV_ENTITY=
HA_POLLEN_ENTITY=

# Set false only for a self-signed HA certificate. This disables TLS
# verification for the whole process — prefer a valid certificate.
HA_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# Pollen (optional)
# ---------------------------------------------------------------------------
# The pollen slide needs a dedicated source. Without one it self-skips.
#   auto        use whichever key is present   (default)
#   google      Google Pollen API — worldwide, incl. the US
#   ambee       Ambee — 100 calls/day free
#   open-meteo  CAMS, free but Europe only
#   none        disable
POLLEN_PROVIDER=auto
GOOGLE_POLLEN_API_KEY=
AMBEE_API_KEY=

# ---------------------------------------------------------------------------
# Lower ticker (the scrolling line above the affiliate logo)
# ---------------------------------------------------------------------------
# Comma-separated RSS, Atom or JSON Feed URLs. Headlines are merged, de-duped,
# sorted newest-first, stripped of markup, and scrolled across the bottom.
#
# A self-hosted RSS-Bridge works well here. Its format=Json output is the least
# fragile to parse, e.g.:
#   http://rssbridge.lan/?action=display&bridge=...&format=Json
#
# Leave empty to fall back to MARQUEE_MESSAGES.
MARQUEE_FEEDS=

# How many headlines to keep in rotation, and how often to re-fetch.
MARQUEE_MAX_ITEMS=12
MARQUEE_TTL_MINUTES=15

# Prefix each headline with its feed's name ("BBC News: ...").
# The name is tidied first: boilerplate publishers append to their feed titles
# is dropped, so "Ars Technica - All Content" reads as "Ars Technica", while a
# meaningful section like "BBC News - World" is kept. Titles too long to be a
# name get no prefix at all.
MARQUEE_SHOW_SOURCE=true

# Static text used when no feed is configured or every feed is unreachable.
# Pipe-separated for multiple messages.
MARQUEE_MESSAGES=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HTTP_PORT=8080
NODE_ENV=production
LOG_REQUESTS=false

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Cached server-side and shared by every viewer, so one fetch serves all
# screens. The defaults keep a continuously-running display well inside every
# provider's free allowance.
CACHE_TTL_MINUTES=10

# How often the radar listing is re-polled. This also paces the rolling
# three-hour frame buffer: RainViewer only ever lists the last two hours, so the
# backend keeps what it has seen to fill out the loop the slide's legend
# promises. Each listing carries the whole two hours, so a longer interval only
# means the third hour takes longer to build up after a restart — it does not
# leave gaps until it exceeds two hours.
RADAR_UPDATE_INTERVAL=5
ALERTS_TTL_MINUTES=2
GEOCODE_TTL_HOURS=168
ALMANAC_TTL_HOURS=24
AIRPORT_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_RADAR=true
ENABLE_SATELLITE=true
ENABLE_ALERTS=true
ENABLE_AIRPORTS=true
ENABLE_ALMANAC=true
ENABLE_POLLEN=true
ENABLE_HEALTH_INDICES=true

# ---------------------------------------------------------------------------
# Mapbox styles (REQUIRED for roads, borders and city labels)
# ---------------------------------------------------------------------------
# Left blank, these fall back to the upstream author's styles. Those are
# readable by any token, but their vector data comes from that account's
# PRIVATE tilesets — and Mapbox fails a composite source when any member is
# inaccessible. The result is maps with terrain and water but no roads, no
# state lines and no city labels.
#
# Fix it once, with a SECRET token (styles:read, styles:list, styles:write)
# that must NOT be stored in this file:
#
#   MAPBOX_WRITE_TOKEN=sk.your_token npm run fork-styles -- --create
#
# That copies the styles into your account, swaps the private tilesets for
# public Mapbox equivalents, and prints the five lines to paste in below.
MAPBOX_STYLE_RADAR=
MAPBOX_STYLE_SATELLITE=
MAPBOX_STYLE_MINIMAP=
MAPBOX_BASE_STYLE_USER=
MAPBOX_BASE_STYLE_ID=
