# Only server/, webroot/ and package.json are copied into the image; this keeps
# the build context small and makes sure secrets never enter it.
.git
.gitignore
.gitattributes
.github/

.env
.env.*
!.env.example

node_modules/
npm-debug.log
package-lock.json

test/
# The image builds the split icon sprites, so it needs that one script. The
# Mapbox fork tool reads a write token and has no business in the image.
scripts/*
!scripts/split-icon-sprites.js
*.md
!README.md

.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

coverage/
.nyc_output/
.cache/
logs/
*.log

# Vendored source maps are dev artifacts; ~930KB of dead weight in the image.
**/*.js.map

# Derived from the sprite sheets by scripts/split-icon-sprites.js during the
# build. Never copy a host copy in; it would only be stale weight in the context.
webroot/images/icons/
