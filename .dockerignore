# Only server/, webroot/ and package.json are copied into the image; this keeps
# the build context small and makes sure secrets never enter it.
.git
.gitignore
.gitattributes
.github/

.env
.env.*
!.env.example

node_modules/
npm-debug.log
package-lock.json

test/
scripts/
*.md
!README.md

.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

coverage/
.nyc_output/
.cache/
logs/
*.log

# Vendored source maps are dev artifacts; ~930KB of dead weight in the image.
**/*.js.map
